PORT=8081
# La documentación y el schema solo deben exponerse en desarrollo.
DOCS_ENABLED=true

# MySQL propio de Inventory (mysql-inventory en docker-compose.example.yml).
# En producción se puede definir DB_URL completa para configurar TLS, por ejemplo:
# DB_URL=jdbc:mysql://mysql.example.internal:3306/inventory_db?sslMode=VERIFY_IDENTITY
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=inventory_password
DB_POOL_MAX=10

# Access tokens. Deben coincidir exactamente con Auth y el Gateway.
# npm run setup copia aquí el mismo JWT_SECRET de los demás servicios.
JWT_SECRET=replace-with-at-least-32-random-bytes-matching-auth-and-gateway
JWT_ISSUER=techdistribution-auth
JWT_AUDIENCE=techdistribution-api
JWT_MAX_TTL_SECONDS=900

# Publicador del outbox hacia Kafka. Con el publicador desactivado los eventos
# se acumulan en outbox_events y se envían al activarlo.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# Consumidor de usuarios de Auth (grupo inventory.auth-users.v1). earliest solo
# aplica la primera vez que el grupo se conecta: así recibe los usuarios ya creados.
USERS_CONSUMER_ENABLED=true
USERS_CONSUMER_AUTO_OFFSET_RESET=earliest
