PORT=3001
NODE_ENV=development
# La documentación y el schema solo deben exponerse en desarrollo.
DOCS_ENABLED=true

# PostgreSQL propio de Auth (postgres-auth en docker-compose.example.yml).
# Fuera de producción estos son también los valores por defecto; en producción
# DB_HOST, DB_NAME, DB_USER y DB_PASSWORD son obligatorios.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_password
DB_POOL_MAX=10
# Base usada por las pruebas e2e; se recrea en cada ejecución y debe terminar en _test.
# DB_TEST_NAME=auth_db_test

# Access tokens. Deben coincidir exactamente con el Gateway (y con los servicios
# que validan tokens): copia aquí el mismo JWT_SECRET de apps/backend/api-gateway/.env.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_the_same_secret_as_the_gateway
JWT_ISSUER=techdistribution-auth
JWT_AUDIENCE=techdistribution-api
# Vigencia máxima en segundos (máximo 3600); el TTL de cada sistema nunca la supera.
JWT_MAX_TTL_SECONDS=900

# Sesión web renovable. En producción REFRESH_COOKIE_SECURE debe ser true.
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_SECURE=false

# Publicador del outbox hacia Kafka (Kafka del Compose en loopback). En
# producción KAFKA_BOOTSTRAP_SERVERS es obligatorio. Con el publicador
# desactivado los eventos se acumulan en outbox_events y se envían al activarlo.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
