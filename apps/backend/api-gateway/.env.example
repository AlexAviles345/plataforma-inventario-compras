PORT=3000
NODE_ENV=development
# Generate locally; never reuse this placeholder. Must match Auth and validators.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ISSUER=techdistribution-auth
JWT_AUDIENCE=techdistribution-api
JWT_MAX_TTL_SECONDS=900
AUTH_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:8081
PURCHASES_SERVICE_URL=http://localhost:8000
PROXY_TIMEOUT_MS=10000
MAX_BODY_BYTES=1048576
CORS_ORIGINS=http://localhost:5173
# Must be false in production, including upstream documentation endpoints.
DOCS_ENABLED=true
